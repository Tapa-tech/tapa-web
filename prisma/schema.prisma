datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  GOOGLE
  PHONE_OTP
}

model User {
  id            String        @id @default(cuid())
  role          UserRole      @default(CUSTOMER)
  email         String?       @unique
  phone         String?       @unique
  name          String?
  image         String?
  passwordHash  String?       // Hashed password for email/password credentials
  emailVerified DateTime?
  phoneVerified DateTime?

  // --- Consent fields ---
  consentGiven      Boolean   @default(false)
  consentGivenAt    DateTime?
  consentVersion    String?   // e.g. "v1.0"
  consentIpAddress  String?   // IP at time of consent

  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts      OAuthAccount[]
  refreshTokens RefreshToken[]
  otpRequests   OTPRequest[]
  savedGuides   RitualGuide[]  @relation("SavedGuides")
  downloadRecords DownloadRecord[]

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  tapaCircleSubscriber TapaCircleSubscriber?
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  family      String
  revoked     Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([userId])
  @@index([family])
}

model OTPRequest {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  phone       String
  codeHash    String
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([phone])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum SourceType {
  VEDIC
  PURANIC
  SHASTRA
  SCHOLARLY
  ORAL
}

enum DPBTag {
  DHARMA
  PRATHA
  BHRANTI
}

enum ReviewStatus {
  PENDING_FOUNDER_REVIEW
  APPROVED
  REJECTED
}

model RitualGuide {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  status            ContentStatus       @default(DRAFT)
  category          String              // e.g. "Festive Pujans", "All-year Pujans", "Navagraha Pujans"
  introText         String              @db.Text
  introTitle        String?
  introDesc         String?             @db.Text
  sankalpaBody      String              @db.Text
  sankalpaQuote     String              @db.Text            // "Say this - or your own words" card
  fastOptions       Json                // [{ name: "Nirjala", desc: "...", recommended: bool }]
  fastNote          String              @db.Text            // the Bhranti correction line for fasting
  steps             RitualStep[]
  mantras           Mantra[]
  kathaTitle        String
  kathaBody         String              @db.Text
  aartiBody         String?             @db.Text
  samagriItems      SamagriItem[]
  dpbEntries        DPBEntry[]
  sources           RitualGuideSource[]
  faqs              RitualGuideFAQ[]
  thumbnailUrl          String?
  audioUrl              String?
  panchangObservance    String?
  panchangObservanceSub String?
  panchangAlignment     String?
  panchangMuhurta       String?
  panchangMuhurtaSub    String?
  panchangTithi         String?
  panchangTithiSub      String?
  panchangVijay         String?
  panchangVijaySub      String?
  panchangNote          String?             @db.Text
  panchangDays          Json?
  
  // New CMS editable fields
  heroStoryImage        String?
  heroImageCaption      String?
  narrationAudioFileUrl String?
  narrationDuration     String?
  narrationLanguage     String?
  heroCtaButtons        Json?
  sankalpaWho           String?
  sankalpaWhenWhere     String?
  sankalpaForWhat       String?
  sankalpaLanguageNote  String?
  sankalpaTitle         String?
  sankalpaSub           String?
  sankalpaDesc          String?             @db.Text
  vidhiTitle            String?
  vidhiSubtitle         String?
  vidhiMuhuratNote      String?             @db.Text
  nineFormsBannerImage  String?
  nineFormsBannerCaption String?
  nineFormsTable        Json?
  nineFormsColourNote   String?
  nineFormsOfferingsNote String?
  kathaSourceLabel      String?
  kathaCardHeadline     String?
  kathaCardTeaser       String?
  kathaAudioDuration    String?
  kathaAudioFileUrl     String?
  kathaSteps            Json?
  kathaWhyNineNightsNote String?
  ashtamiNavamiBody     String?             @db.Text
  ashtamiNavamiTag      String?
  ashtamiNavamiSandhiNote String?
  deepDiveTitle         String?
  deepDiveTeaser        String?
  deepDiveBody          String?             @db.Text
  deepDiveConceptId     String?
  deepDiveClosingText   String?
  relatedRitualGuides   Json?
  relatedPujans         Json?
  relatedConcepts       Json?
  relatedDates          Json?
  preferCareGlobal      Boolean             @default(true)
  kitName               String?
  kitPrice              String?
  kitDescription        String?
  purohitServiceDescription String?
  tapaCircleDescription String?
  showKitCard           Boolean             @default(true)
  showPurohitCard       Boolean             @default(true)
  showCircleCard        Boolean             @default(true)

  createdAt             DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  savedBy           User[]              @relation("SavedGuides")
}

model RitualStep {
  id            String      @id @default(cuid())
  ritualGuideId String
  ritualGuide   RitualGuide @relation(fields: [ritualGuideId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  description   String      @db.Text
  note          String?     @db.Text            // Pratha correction embedded in a step, e.g. "Green attire is regional custom"
  stepTags      String?
}

model Mantra {
  id              String      @id @default(cuid())
  ritualGuideId   String
  ritualGuide     RitualGuide @relation(fields: [ritualGuideId], references: [id], onDelete: Cascade)
  devanagari      String
  transliteration String
  meaning         String
  audioUrl        String?
}

model SamagriItem {
  id            String      @id @default(cuid())
  ritualGuideId String
  ritualGuide   RitualGuide @relation(fields: [ritualGuideId], references: [id], onDelete: Cascade)
  name          String      // "Sindoor"
  function      String      // "For Maa Parvati's offering" — item · function pattern from content spec
  order         Int
}

model DharmicConcept {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  status       ContentStatus @default(DRAFT)
  body         String        @db.Text            // paragraph-led, Tiptap JSON stored as text
  thumbnailUrl String?
  dpbEntries   DPBEntry[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
enum PanchangDataSource {
  AUTO_SYNCED
  MANUAL_OVERRIDE
}

model PanchangEntry {
  id            String             @id @default(cuid())
  date          DateTime
  city          String             @default("Delhi-NCR")
  tithi         String
  tithiSub      String             // "7th day"
  paksha        String             // "Shukla" / "Krishna"
  pakshaSub     String             // "Waxing moon" / "Waning moon"
  nakshatra     String
  nakshatraSub  String?            // "Auspicious" — only when genuinely true, per content spec
  sunrise       String             // "5:28"
  sunset        String?
  dataSource    PanchangDataSource @default(AUTO_SYNCED)
  syncedAt      DateTime?          // when the automated sync last wrote/refreshed this record
  overriddenBy  String?            // admin userId, if manually corrected
  overriddenAt  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([date, city])
}

model VratEntry {
  id            String   @id @default(cuid())
  name          String   // "Yogini Ekadashi"
  date          DateTime
  category      String   // "Ekadashi" / "Pradosh" / "Purnima" / etc. — for filter chips
  description   String?  @db.Text
  linkedGuideId String?  // optional link to a RitualGuide if one exists for this vrat
  createdAt     DateTime @default(now())
}

model Source {
  id           String              @id @default(cuid())
  name         String              // "Shiva Purana"
  reference    String              // "Rudra Samhita / Parvati Khanda"
  type         SourceType
  ritualGuides RitualGuideSource[]
  createdAt    DateTime            @default(now())
}

model RitualGuideSource {
  ritualGuideId String
  ritualGuide   RitualGuide @relation(fields: [ritualGuideId], references: [id], onDelete: Cascade)
  sourceId      String
  source        Source      @relation(fields: [sourceId], references: [id])

  @@id([ritualGuideId, sourceId])
}

model FAQ {
  id           String           @id @default(cuid())
  question     String
  answer       String           @db.Text
  ritualGuides RitualGuideFAQ[]
  createdAt    DateTime         @default(now())
}

model RitualGuideFAQ {
  ritualGuideId String
  ritualGuide   RitualGuide @relation(fields: [ritualGuideId], references: [id], onDelete: Cascade)
  faqId         String
  faq           FAQ         @relation(fields: [faqId], references: [id])
  order         Int

  @@id([ritualGuideId, faqId])
}

model DPBEntry {
  id               String          @id @default(cuid())
  ritualGuideId    String?
  ritualGuide      RitualGuide?    @relation(fields: [ritualGuideId], references: [id], onDelete: Cascade)
  dharmicConceptId String?
  dharmicConcept   DharmicConcept? @relation(fields: [dharmicConceptId], references: [id], onDelete: Cascade)
  elementName      String
  tag              DPBTag
  confidenceScore  Int
  claim            String?         @db.Text
  correction       String?         @db.Text
  sourceOfTruth    String?         @db.Text
  regionalVariance String?         @db.Text
  reviewStatus     ReviewStatus    @default(PENDING_FOUNDER_REVIEW)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model RitualKit {
  id          String   @id
  name        String
  hindi       String?
  occ         String
  deity       String
  price       Float
  mrp         Float?
  inStock     Boolean  @default(true)
  stockLeft   Int?
  itemsCount  String
  ribbon      String?
  delivery    String
  isFeatured  Boolean  @default(false)
  description String?  @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DownloadContentType {
  RITUAL_GUIDE_PDF
  SAMAGRI_CHECKLIST
  PANCHANG_CALENDAR
}

model DownloadRecord {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType   DownloadContentType
  contentId     String?             // RitualGuide.id when relevant; null for the Panchang calendar
  contentTitle  String              // denormalized snapshot of the title at download time
  downloadedAt  DateTime            @default(now())
  ipAddress     String?
  userAgent     String?

  @@index([userId])
  @@index([contentType])
}

model UpcomingFeature {
  id            String   @id @default(cuid())
  key           String   @unique  // "ritual_kits" | "purohit_booking" | "bhajan_mandali"
  launchLabel   String?  // e.g. "LAUNCHING September 24th" — null if no specific date is set yet
  badgeText     String?  // e.g. "Launching soon" — shown on nav tabs/cards
  teaserTitle   String?  // e.g. "Complete Samagri for every puja."
  teaserBody    String?  // e.g. "Ritually correct. Sourced right. Delivered before your ritual."
  isLive        Boolean  @default(false) // flips to true when the real feature ships in a later gate
  updatedAt     DateTime @updatedAt
}

model AnnouncementMessage {
  id          String    @id @default(cuid())
  message     String
  isActive    Boolean   @default(false) // only one should be active at a time — enforce this in the admin UI/logic
  startDate   DateTime? // optional scheduling — e.g. auto-activate during Sawan
  endDate     DateTime?
  priority    Int       @default(0)     // if multiple are active/scheduled to overlap, higher priority wins
  createdAt   DateTime  @default(now())
}

enum ProductType {
  SAMAGRI_ITEM
  PUJA_KIT
}

enum CODAvailability {
  AVAILABLE
  NOT_AVAILABLE
}

enum PaymentMethod {
  COD
  RAZORPAY_UPI
  RAZORPAY_CARD
  RAZORPAY_NETBANKING
}

enum PaymentStatus {
  PENDING_ON_DELIVERY
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            ProductType
  description     String           @db.Text
  images          String[]         // Array of image URLs
  price           Decimal          @db.Decimal(10, 2)
  mrp             Decimal?         @db.Decimal(10, 2) // Struck-through original price
  stock           Int              @default(0)
  category        String           // Occasion or category for COD grouping
  codAvailability CODAvailability  @default(AVAILABLE)
  kitItems        KitItem[]        // Mapped when type = PUJA_KIT
  linkedRitualGuideId String?      // Mapped to helper article
  status          ContentStatus    @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
}

model KitItem {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  itemName     String
  itemFunction String   // "For Maa Parvati's offering"
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // format: TK-2026-0714 per content spec
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  items             OrderItem[]
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus
  orderStatus       OrderStatus   @default(CONFIRMED)
  totalAmount       Decimal       @db.Decimal(10, 2)
  deliveryAddress   Json          // snapshot of address at order time
  estimatedDelivery DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String   // denormalized snapshot
  quantity     Int
  priceAtOrder Decimal  @db.Decimal(10, 2)
}

model TapaCircleSubscriber {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  whatsappNumber String
  consentGiven   Boolean   @default(false)
  consentGivenAt DateTime?
  status         String    @default("PENDING_PAYMENT")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model BroadcastMessage {
  id              String   @id @default(cuid())
  message         String   @db.Text
  recipientsCount Int
  sentAt          DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String   // "ROLE_CHANGE" | "USER_DEACTIVATED" | "USER_ACTIVATED" | "ORDER_STATUS_OVERRIDE" | etc.
  targetType   String   // "User" | "Order" | "Product" etc.
  targetId     String
  performedBy  String   // userId of the admin/super-admin who did it
  details      Json?    // e.g. { from: "ADMIN", to: "SUPER_ADMIN" }
  createdAt    DateTime @default(now())
}

model HomepageBanner {
  id              String   @id @default(cuid())
  isActive        Boolean  @default(false)
  imageUrl        String   // Banner background image
  orderByDate     DateTime? // Order-by date
  festivalTitle   String   // e.g. "Complete Ganesh Chaturthi Puja Kit"
  mainHeading     String   // e.g. "Complete Ganesh Chaturthi"
  highlightedText String   // e.g. "Puja Kit"
  description     String   @db.Text
  price           Decimal  @db.Decimal(10, 2)
  mrp             Decimal? @db.Decimal(10, 2) // Optional original struck-through price
  primaryCtaText  String   @default("Pre-book Kit now ›")
  primaryCtaLink  String   @default("/cart")
  secondaryCtaText String? @default("View Kit Details")
  secondaryCtaLink String? @default("/ritual-kits")
  festivalDate    DateTime? // Festival/event date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}



